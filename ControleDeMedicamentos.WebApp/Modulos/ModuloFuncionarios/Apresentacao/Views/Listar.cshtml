@model List<ControleDeMedicamentos.WebApp.Modulos.ModuloFuncionarios.Apresentacao.ListarFuncionarioViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Funcionário";
}
<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar funcionário
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum funcionário registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (var f in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@f.Nome</h5>
                            <span class="badge text-bg-secondary">@f.Id</span>
                        </div>

                        <dl class="row mb-2">
                            <dt class="col-sm-4">Telefone</dt>
                            <dd class="col-sm-8">@f.Telefone</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@f.Id">
                                Editar
                            </a>

                            <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@f.Id">
                                Excluir
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}