@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fornecedor";
}

<div class="row justify-content-start">
    <form class="col-8" action="/Fornecedor/Cadastrar" method="post">

        <div>
            <label class="form-label" for="nome">Nome</label>
            <input class="form-control" id="nome" name="nome" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" for="telefone">Telefone</label>
            <input class="form-control" id="telefone" name="telefone" type="text">
        </div>

        <div class="mt-4">
            <label class="form-label" for="cnpj">CNPJ</label>
            <input class="form-control" id="cnpj" name="cnpj" type="text">
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">Cadastrar</button>
            <a class="btn btn-outline-secondary" href="/Fornecedor/Listar">Voltar para a lista</a>
        </div>
    </form>
</div>
