@model List<Fornecedor>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fornecedor";
}

<p>
    <a href="Cadastrar">Cadastrar fornecedor</a>
    <p />

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CNPJ</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Fornecedor f in Model)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nome</td>
                    <td>@f.Telefone</td>
                    <td>@f.Cnpj</td>
                    <td>
                        <a href="Editar/@f.Id">Editar</a>
                        <span> | </span>
                        <a href="Excluir/@f.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>