@model Fornecedor;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Fornecedor";
}

<div class="row justify-content-start">
    <form class="col-8" action="/Fornecedor/Excluir/@Model.Id" method="post">
        <div class="alert alert-danger mt-4" role="alert">
            Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível.
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-danger" type="submit">Confirmar</button>
            <a class="btn btn-outline-secondary" href="/Fornecedor/Listar">Voltar para a lista</a>
        </div>
    </form>
</div>